{
  "name": "relay-lab",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "vitest run",
    "typecheck": "nuxi typecheck",
    "postinstall": "nuxt prepare",
    "deploy": "pnpm d1:migrate:remote && nuxt build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "d1:migrate:local": "wrangler d1 migrations apply relay-lab --local",
    "d1:migrate:remote": "wrangler d1 migrations apply relay-lab --remote"
  },
  "dependencies": {
    "@nuxt/ui": "^4.9.0",
    "@pinia/nuxt": "^0.11.3",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@iconify-json/carbon": "^1.2.23",
    "@types/node": "^24.0.0",
    "better-sqlite3": "^12.11.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.0.0"
  }
}
