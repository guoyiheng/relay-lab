# ── 本地开发：直连线上 D1 + R2 ────────────────────────────────────────────────
# wrangler.jsonc 里 D1/R2 binding 都开了 `remote: true`，`npm run dev` 直连线上，
# 本地数据与线上一致。这需要 wrangler 认证，二选一：
#
#   方式 A（推荐，无浏览器也行）：把 API Token 填到本文件复制出的 `.env` 里。
#     ⚠️ 必须是 `.env`——Nuxt dev 只加载 `.env`，不读 `.env.local`。
#   方式 B：在能开浏览器的终端跑 `npx wrangler login`（凭证存系统钥匙链）。
#
# API Token 在 Cloudflare 面板 → My Profile → API Tokens → Create Token 生成，
# 需要权限：Account 级 D1 Edit + Workers R2 Storage Edit。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 想临时回到本地模拟库（不连线上、不需认证）：把 wrangler.jsonc 两处 `remote` 改
# false，再 `npm run d1:migrate:local` 建本地表。

# ── 首个登录用户 ────────────────────────────────────────────────────────────────
#   node scripts/create-user.mjs <用户名> <密码> | npx wrangler d1 execute relay-lab --remote --file=/dev/stdin

# ── 邮箱邀请注册（敏感值生产环境请用 `wrangler secret put` 注入）──────────────
RESEND_API_KEY=
RESEND_FROM=Relay Lab <noreply@example.com>
REGISTRATION_INVITE_CODE=
AUTH_IP_HASH_SECRET=
# 可选；为空时按请求 Origin 生成验证链接。
PUBLIC_APP_URL=

# 离线代理生产环境默认只允许 HTTPS 上游。仅在明确接受 API Key 经明文 HTTP
# 传输风险时设为 1；生产环境不建议开启。
OFFLINE_PROXY_ALLOW_HTTP=0
